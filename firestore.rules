rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // ---- Public read collections ----
    // Lakes, species, and statewide regulations are public reference data.

    match /lakes/{lakeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /species_registry/{speciesId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /lures_colors/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /statewide_defaults/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /regulations/{regId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /regulation_alerts/{alertId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /border_waters/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ice_roads/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- Authenticated read, admin write (survey/scientific data) ----

    match /netting_surveys/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /electrofishing_surveys/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /stocking_events/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /winterkill_events/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /water_quality/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /creel_surveys/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /aeration_events/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /similar_lakes/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /lake_contour_metadata/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /lake_structures/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---- Ice reports: safety-critical, public read ----

    match /ice_reports/{id} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() &&
        (resource.data.submittedBy == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ---- User-owned data ----

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) &&
        request.resource.data.uid == userId;
      allow update: if isOwner(userId) &&
        request.resource.data.uid == resource.data.uid;
      allow delete: if isAdmin();
    }

    match /angler_reports/{reportId} {
      allow read: if
        (resource.data.isPublic == true) ||
        (isSignedIn() && resource.data.userId == request.auth.uid) ||
        isAdmin();
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /guide_portal_users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    // ---- System/cache collections: Cloud Functions Admin SDK only ----
    // Admin SDK bypasses rules; explicit false prevents accidental client writes.

    match /weather_cache/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /live_intelligence_cache/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /contour_update_log/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /report_sources/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
