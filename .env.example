# ============================================================
# CastIQ Environment Variables
# Copy this file to .env and fill in values for your environment.
# NEVER commit .env to version control.
# ============================================================

# Firebase (Frontend — safe to expose in browser builds)
# Get from Firebase Console > Project Settings > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to point the frontend at local Firebase Emulators
VITE_USE_EMULATORS=false

# Mapbox (Frontend — public token; scope to your domains in Mapbox dashboard)
VITE_MAPBOX_ACCESS_TOKEN=

# Tomorrow.io Weather API (Frontend)
VITE_TOMORROW_API_KEY=

# Navionics Chart API (Frontend)
VITE_NAVIONICS_API_KEY=

# ============================================================
# Server-side only (Cloud Functions + seed scripts)
# For deployed functions, set via:
#   firebase functions:secrets:set ANTHROPIC_API_KEY
# For local seed scripts, set here or via GOOGLE_APPLICATION_CREDENTIALS.
# ============================================================

# Anthropic Claude API — NEVER expose in frontend code
ANTHROPIC_API_KEY=

# Fishbrain Partner API — server-side only
FISHBRAIN_PARTNER_API_KEY=

# Firebase Admin (for local seed scripts)
FIREBASE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json
