{
  "name": "castiq-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "functions"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "seed:lakes": "tsx scripts/seedLakes.ts",
    "seed:species": "tsx scripts/seedSpecies.ts",
    "seed:regulations": "tsx scripts/seedRegulations.ts",
    "ingest:dnr": "tsx scripts/ingestDNR.ts",
    "functions:build": "npm run build --workspace=functions",
    "functions:serve": "firebase emulators:start --only functions,firestore,auth,storage"
  },
  "dependencies": {
    "firebase": "^10.14.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "date-fns": "^3.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "tsx": "^4.19.2",
    "firebase-admin": "^12.7.0",
    "eslint": "^8.57.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0"
  }
}
